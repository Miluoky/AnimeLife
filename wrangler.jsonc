// Публикация на Cloudflare Workers (Workers Builds, подключён к GitHub): статические файлы сайта
// и небольшой Worker (worker/index.js) для превью ссылок, sitemap.xml и прокси данных.
{
  "name": "anime",
  "compatibility_date": "2026-09-01",
  // web-push (Core push.js) нужен Node crypto/Buffer на Workers.
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.js",
  "build": { "command": "npm run build" },
  // Переменные из панели Cloudflare (коды подтверждения для поисковиков, см. README) не стираются при публикации.
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Маршруты React: на любой незнакомый адрес отдаём index.html.
    "not_found_handling": "single-page-application",
    // Каждый вызов Worker идёт в лимит (100 тыс. в сутки на бесплатном тарифе), поэтому run_worker_first нет:
    // сначала ищется файл сборки. Переход человека по странице (Sec-Fetch-Mode: navigate) Cloudflare сам отдаёт
    // статическим index.html без Worker. Остальные запросы без файла (поисковики и превью ссылок, /api/* из
    // приложения, карта сайта) попадают в Worker: canonical, заголовки, превью, 404. См. docs/worker-limit.md.
    // Список путей в run_worker_first тут не подходит: с ним Cloudflare перестаёт различать переходы браузера,
    // и поисковики получали бы голый index.html.
    "run_worker_first": false
  },
  // AnimeLife Core (вместо Appwrite): auth/сессии/таблицы. См. worker/core/README.md
  "d1_databases": [
    { "binding": "DB", "database_name": "anime_core", "database_id": "68a5d9ac-972d-4b24-b0f4-2da7e8636e81" }
  ],
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "8e2bdf43b8de4282a4d191964577cc14" }
  ],
  // Страницы своих глав манги (worker/core/manga.js). Создайте: npx wrangler r2 bucket create anime-manga
  "r2_buckets": [{ "binding": "MANGA", "bucket_name": "anime-manga" }],
  // Чистка старых комнат/сообщений — раз в час, не бьёт лимит зрителей.
  "triggers": { "crons": ["17 * * * *"] }
}
