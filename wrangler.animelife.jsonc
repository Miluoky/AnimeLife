// Публикация на собственный домен animelife.top. Домен и этот Worker живут в аккаунте Cloudflare от регистратора,
// поэтому публикует их не Workers Builds, а GitHub Actions (.github/workflows/animelife.yml).
// Остальные настройки совпадают с wrangler.jsonc.
{
  "name": "anime",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.js",
  "keep_vars": true,
  // Коды подтверждения сайта в поисковиках (не секретные, видны в <head> каждой страницы).
  "vars": { "YANDEX_VERIFICATION": "55f906a71e246741" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Без Worker первым: страницы для людей отдаются статикой, Worker — поисковикам, превью и /api/*.
    // Почему так и как откатить: wrangler.jsonc и docs/worker-limit.md.
    "run_worker_first": false
  },
  "routes": [
    { "pattern": "animelife.top", "custom_domain": true },
    { "pattern": "www.animelife.top", "custom_domain": true }
  ]
}
